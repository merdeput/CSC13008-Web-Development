{
  "name": "bep-hoi-restaurant",
  "version": "1.0.0",
  "private": true,
  "description": "Vietnamese restaurant website built with Express, EJS, Prisma, and Supabase PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:tls": "node scripts/deploy-migrations-tls.js",
    "db:seed": "prisma db seed",
    "db:seed:phocafe": "node seed-phocafe-new.mjs --apply --demo-prices --factory=./src/lib/seed-prisma-factory.mjs",
    "db:seed:bep-hoi": "node prisma/seed-bephoi.js",
    "db:seed:private-chefs": "node scripts/seed-private-chefs.js",
    "test": "node --test",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.0.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "method-override": "^3.0.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "prisma": "^7.0.0",
    "supertest": "^7.1.4"
  }
}
