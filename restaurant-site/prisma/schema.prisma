generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum UserStatus {
  PENDING
  ACTIVE
}

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(80)
  slug      String   @unique @db.VarChar(120)
  sortOrder Int      @default(0)
  dishes    Dish[]

  @@map("Category")
}

model Dish {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String           @db.Uuid
  chefId      String?          @db.Uuid
  name        String           @db.VarChar(120)
  slug        String           @unique @db.VarChar(140)
  description String           @db.VarChar(2400)
  price       Decimal          @db.Decimal(12, 0)
  imageUrl    String?          @db.VarChar(2048)
  isPublished Boolean          @default(false)
  isAvailable Boolean          @default(true)
  isFeatured  Boolean          @default(false)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  chef        Chef?            @relation(fields: [chefId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  ingredients DishIngredient[]

  @@index([categoryId])
  @@index([chefId])
  @@index([isPublished, isFeatured])
  @@map("Dish")
}

model Ingredient {
  id     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name   String           @unique @db.VarChar(100)
  dishes DishIngredient[]

  @@map("Ingredient")
}

model DishIngredient {
  dishId       String     @db.Uuid
  ingredientId String     @db.Uuid
  dish         Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([dishId, ingredientId])
  @@index([ingredientId])
  @@map("DishIngredient")
}

model Chef {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(120)
  title       String   @db.VarChar(140)
  bio         String?  @db.VarChar(2400)
  specialty   String?  @db.VarChar(180)
  imageUrl    String?  @db.VarChar(2048)
  isPublished Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  dishes      Dish[]

  @@index([isPublished, sortOrder])
  @@map("Chef")
}

model Reservation {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referenceCode String            @unique @db.VarChar(20)
  customerName  String            @db.VarChar(120)
  phone         String            @db.VarChar(40)
  email         String?           @db.VarChar(254)
  guestCount    Int
  startsAt      DateTime          @db.Timestamptz(6)
  status        ReservationStatus @default(PENDING)
  customerNote  String?           @db.VarChar(1200)
  adminNote     String?           @db.VarChar(1200)
  createdAt     DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime          @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([startsAt])
  @@index([status, startsAt])
  @@map("Reservation")
}

model User {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String   @unique @db.VarChar(254)
  passwordHash    String   @db.VarChar(255)
  role            String   @default("viewer") @db.VarChar(40)
  status          UserStatus @default(PENDING)
  emailVerifiedAt DateTime? @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  activationChallenges ActivationChallenge[]
  passwordReset   PasswordReset?
  sessions        Session[]

  @@map("User")
}

model ActivationChallenge {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @db.Uuid
  purpose      String   @db.VarChar(32)
  otpHash      String   @db.Char(64)
  expiresAt    DateTime @db.Timestamptz(6)
  attempts     Int      @default(0)
  lockedUntil  DateTime? @db.Timestamptz(6)
  resendCount  Int      @default(0)
  lastSentAt   DateTime @db.Timestamptz(6)
  usedAt       DateTime? @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, purpose])
  @@index([expiresAt])
  @@map("ActivationChallenge")
}

model PasswordReset {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @unique @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([expiresAt])
  @@map("PasswordReset")
}

model LoginFailureCounter {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  keyType         String    @db.VarChar(16)
  keyHash         String    @db.Char(64)
  failureCount    Int       @default(0)
  windowStartedAt DateTime  @db.Timestamptz(6)
  lockedUntil     DateTime? @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([keyType, keyHash])
  @@index([lockedUntil])
  @@map("LoginFailureCounter")
}

model Session {
  id        String   @id @db.VarChar(255)
  sid       String   @unique @db.VarChar(255)
  userId    String?  @db.Uuid
  data      String   @db.Text
  expiresAt DateTime @db.Timestamptz(6)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("Session")
}
