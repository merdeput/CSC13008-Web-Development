<section class="auth-page section-pad">
  <div class="auth-card">
    <p class="eyebrow">BẾP HỘI / BẢO MẬT</p>
    <h1>Tạo mật khẩu mới</h1>
    <% if (error) { %><p class="auth-message auth-message-error" role="alert"><%= error %></p><% } %>
    <% if (valid) { %>
      <form class="auth-form" action="/password-reset/confirm" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
        <input type="hidden" name="token" value="<%= token %>">
        <label for="reset-password">Mật khẩu mới</label>
        <input id="reset-password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required>
        <p class="auth-help">Mật khẩu cần ít nhất 12 ký tự, tối đa 128 byte, một chữ hoa, một chữ số và một ký tự đặc biệt.</p>
        <button class="button button-dark button-wide" type="submit">Cập nhật mật khẩu</button>
      </form>
    <% } %>
    <p class="auth-switch"><a href="/login">Quay lại đăng nhập</a></p>
  </div>
</section>
