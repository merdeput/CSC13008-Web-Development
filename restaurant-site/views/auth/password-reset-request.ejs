<section class="auth-page section-pad">
  <div class="auth-card">
    <p class="eyebrow">BẾP HỘI / KHÔI PHỤC TÀI KHOẢN</p>
    <h1>Quên mật khẩu</h1>
    <% if (message) { %><p class="auth-message" role="status"><%= message %></p><% } %>
    <% if (error) { %><p class="auth-message auth-message-error" role="alert"><%= error %></p><% } %>
    <% if (available) { %>
      <p>Nhập email của tài khoản. Nếu tài khoản đang hoạt động, chúng tôi sẽ gửi liên kết đặt lại mật khẩu.</p>
      <form class="auth-form" action="/password-reset" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
        <label for="reset-email">Email</label>
        <input id="reset-email" name="email" type="email" autocomplete="email" maxlength="254" required>
        <div class="g-recaptcha" data-sitekey="<%= captchaSiteKey %>" data-theme="light"></div>
        <button class="button button-dark button-wide" type="submit">Gửi liên kết đặt lại</button>
      </form>
      <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <% } %>
    <p class="auth-switch"><a href="/login">Quay lại đăng nhập</a></p>
  </div>
</section>
