<!doctype html>
<html lang="vi" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f4f5ef">
    <title><%= pageTitle || 'Quản trị — Bếp Hội' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="/hoi-an.css">
  </head>
  <body class="admin-shell">
    <a class="skip-link" href="#main-content">Đi đến nội dung</a>
    <header class="admin-topbar">
      <a class="admin-brand" href="/admin"><span class="brand-mark" aria-hidden="true">B</span><span>BẾP HỘI <small>QUẢN TRỊ</small></span></a>
      <a class="admin-back-link" href="/" target="_blank" rel="noreferrer">Xem website <span aria-hidden="true">↗</span></a>
    </header>
    <div class="admin-frame">
      <aside class="admin-sidebar" aria-label="Điều hướng quản trị">
        <p class="admin-sidebar-label">NỘI DUNG NHÀ HÀNG</p>
        <a class="admin-nav-link <%= currentPath === '/admin' ? 'is-current' : '' %>" href="/admin"><span aria-hidden="true">⌂</span> Tổng quan</a>
        <a class="admin-nav-link <%= currentPath.startsWith('/admin/dishes') ? 'is-current' : '' %>" href="/admin/dishes"><span aria-hidden="true">◉</span> Món ăn</a>
        <a class="admin-nav-link <%= currentPath.startsWith('/admin/reservations') ? 'is-current' : '' %>" href="/admin/reservations"><span aria-hidden="true">▦</span> Đặt bàn</a>
        <a class="admin-nav-link <%= currentPath.startsWith('/admin/chefs') ? 'is-current' : '' %>" href="/admin/chefs"><span aria-hidden="true">♨</span> Đầu bếp</a>
        <div class="admin-sidebar-note"><span class="status-dot"></span> Khu vực quản trị đang mở trực tiếp</div>
      </aside>
      <main id="main-content" class="admin-main"><%- body %></main>
    </div>
    <script src="/site.js" defer></script>
  </body>
</html>
