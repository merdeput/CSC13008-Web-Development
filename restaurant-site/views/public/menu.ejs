<section class="page-hero page-hero-menu paper-texture" data-lantern-section data-scroll-drift><div class="wrap page-hero-inner reveal-copy" data-reveal-from="left"><p class="eyebrow">MÓN VIỆT · VỊ PHỐ HỘI</p><h1>Món ngon<br><em>đợi bạn.</em></h1><p>Món ăn theo mùa, nấu vừa tay và luôn có một chút hương vị nhà.</p></div><span class="section-lantern" aria-hidden="true"></span></section>
<section class="menu-section section-pad" data-lantern-section><div class="wrap">
  <form class="menu-search" action="/menu" method="get" role="search"><label class="visually-hidden" for="dish-search">Tìm món ăn hoặc nguyên liệu</label><input id="dish-search" type="search" name="q" value="<%= q %>" placeholder="Tìm tên món, nguyên liệu…"><button class="button button-dark" type="submit">Tìm món <span aria-hidden="true">⌕</span></button></form>
  <nav class="category-filter" aria-label="Lọc theo danh mục"><a class="<%= categoryId ? '' : 'is-active' %>" href="/menu<%= q ? `?q=${encodeURIComponent(q)}` : '' %>">Tất cả món</a><% categories.forEach((category) => { %><a class="<%= categoryId === category.id ? 'is-active' : '' %>" href="/menu?category=<%= encodeURIComponent(category.id) %><%= q ? `&amp;q=${encodeURIComponent(q)}` : '' %>" <%- categoryId === category.id ? 'aria-current="page"' : '' %>><%= category.name %></a><% }) %></nav>
  <p class="result-count"><%= dishes.length %> món<%= q ? ` phù hợp với “${q}”` : '' %></p>
  <% if (dishes.length) { %><div class="dish-card-grid menu-card-grid">
    <% dishes.forEach((dish, index) => { %><article class="dish-card reveal"><a class="dish-card-image" href="/dishes/<%= dish.id %>"><img src="<%= dish.imageUrl || '/images/food-fallback.svg' %>" alt="<%= dish.name %>" loading="lazy" data-scroll-drift><span class="dish-card-index"><%= String(index + 1).padStart(2, '0') %></span><% if (!dish.isAvailable) { %><span class="availability-ribbon">Tạm hết hôm nay</span><% } %></a><div class="dish-card-meta"><span><%= dish.category.name %></span><span><%= formatVnd(dish.price) %></span></div><h2><a href="/dishes/<%= dish.id %>"><%= dish.name %></a></h2><p><%= dish.description %></p><%- include('../partials/ingredient-list', { dish }) %></article><% }) %>
  </div><% } else { %><div class="empty-state"><h2>Chưa tìm thấy món phù hợp</h2><p>Thử một từ khóa khác hoặc xem tất cả món trong thực đơn.</p><a class="text-link" href="/menu">Xem tất cả món <span aria-hidden="true">↗</span></a></div><% } %>

