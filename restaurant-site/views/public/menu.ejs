<section class="page-hero page-hero-menu paper-texture" data-lantern-section data-scroll-drift><div class="wrap page-hero-inner reveal-copy" data-reveal-from="left"><p class="eyebrow">MÓN VIỆT · VỊ PHỐ HỘI</p><h1>Món ngon<br><em>đợi bạn.</em></h1><p>Món ăn theo mùa, nấu vừa tay và luôn có một chút hương vị nhà.</p></div><span class="section-lantern" aria-hidden="true"></span></section>
<section class="menu-section section-pad" data-lantern-section><div class="wrap">
  <form class="menu-search" action="/menu" method="get" role="search">
    <label class="menu-search-mode" for="menu-search-mode">Kiểu tìm kiếm
      <select id="menu-search-mode" name="mode" data-menu-search-mode><option value="basic" <%= mode === 'basic' ? 'selected' : '' %>>Cơ bản</option><option value="advanced" <%= mode === 'advanced' ? 'selected' : '' %>>Nâng cao</option><option value="fulltext" <%= mode === 'fulltext' ? 'selected' : '' %>>Toàn văn</option><option value="fuzzy" <%= mode === 'fuzzy' ? 'selected' : '' %>>Gần đúng</option></select>
    </label>
    <label class="visually-hidden" for="dish-search">Tìm tên món ăn</label>
    <input id="dish-search" type="search" name="q" maxlength="100" value="<%= q %>" placeholder="Tìm tên món…">
    <input type="hidden" name="view" value="<%= view %>">
    <input type="hidden" name="pageSize" value="<%= pageSize %>">
    <% if (mode !== 'advanced' && categoryId) { %><input type="hidden" name="category" value="<%= categoryId %>"><% } %>
    <% if (mode === 'advanced') { %><div class="menu-advanced-fields">
      <label>Danh mục<select name="category"><option value="">Tất cả</option><% categories.forEach((category) => { %><option value="<%= category.id %>" <%= categoryId === category.id ? 'selected' : '' %>><%= category.name %></option><% }) %></select></label>
      <label>Giá từ<input type="number" name="minPrice" min="0" max="999999999999" step="1" value="<%= minPrice %>"></label>
      <label>Giá đến<input type="number" name="maxPrice" min="0" max="999999999999" step="1" value="<%= maxPrice %>"></label>
      <label>Trạng thái<select name="available"><option value="">Tất cả</option><option value="true" <%= available === 'true' ? 'selected' : '' %>>Đang có</option><option value="false" <%= available === 'false' ? 'selected' : '' %>>Tạm hết</option></select></label>
    </div><% } %>
    <div class="menu-search-actions">
      <button class="button button-dark" type="submit">Tìm món <span aria-hidden="true">⌕</span></button>
      <div class="menu-pagination-settings" data-menu-settings-root>
        <button class="menu-settings-button" type="button" aria-label="Chọn kiểu phân trang" aria-expanded="false" aria-controls="menu-pagination-options" data-menu-settings-toggle><span aria-hidden="true">⚙</span></button>
        <div class="menu-pagination-options" id="menu-pagination-options" role="menu" aria-label="Kiểu phân trang" data-menu-settings hidden>
          <p>Kiểu xem thực đơn</p>
          <a class="<%= view === 'pages' ? 'is-active' : '' %>" role="menuitemradio" aria-checked="<%= view === 'pages' %>" href="<%= menuUrl({ view: 'pages', page: 1 }) %>"><span aria-hidden="true">1 2 3</span><strong>Phân trang</strong></a>
          <a class="<%= view === 'load-more' ? 'is-active' : '' %>" role="menuitemradio" aria-checked="<%= view === 'load-more' %>" href="<%= menuUrl({ view: 'load-more', page: 1 }) %>"><span aria-hidden="true">＋</span><strong>Tải thêm</strong></a>
          <a class="<%= view === 'infinite' ? 'is-active' : '' %>" role="menuitemradio" aria-checked="<%= view === 'infinite' %>" href="<%= menuUrl({ view: 'infinite', page: 1 }) %>"><span aria-hidden="true">↓</span><strong>Cuộn vô hạn</strong></a>
        </div>
      </div>
    </div>
    <% if (Object.keys(errors).length) { %><ul class="menu-filter-errors" role="alert"><% Object.values(errors).forEach((message) => { %><li><%= message %></li><% }) %></ul><% } %>
  </form>
  <nav class="category-filter" aria-label="Lọc theo danh mục"><a class="<%= categoryId ? '' : 'is-active' %>" href="<%= menuUrl({ category: '', page: 1 }) %>" <%- categoryId ? '' : 'aria-current="page"' %>>Tất cả món</a><% categories.forEach((category) => { %><a class="<%= categoryId === category.id ? 'is-active' : '' %>" href="<%= menuUrl({ category: category.id, page: 1 }) %>" <%- categoryId === category.id ? 'aria-current="page"' : '' %>><%= category.name %></a><% }) %></nav>
  <% if (awaitingQuery) { %><div class="empty-state"><h2>Nhập từ khóa để tìm kiếm</h2><p>Chế độ toàn văn và gần đúng bắt đầu sau khi bạn nhập từ khóa.</p></div><% } else { %>
    <div class="menu-results-toolbar"><p class="result-count"><%= total %> món<%= q ? ` phù hợp với “${q}”` : '' %></p>
      <form class="menu-page-size" action="/menu" method="get"><input type="hidden" name="q" value="<%= q %>"><input type="hidden" name="mode" value="<%= mode %>"><input type="hidden" name="category" value="<%= categoryId %>"><input type="hidden" name="minPrice" value="<%= minPrice %>"><input type="hidden" name="maxPrice" value="<%= maxPrice %>"><input type="hidden" name="available" value="<%= available %>"><input type="hidden" name="view" value="<%= view %>"><input type="hidden" name="page" value="1"><label for="menu-page-size-input"><%= view === 'pages' ? 'Món mỗi trang' : 'Món mỗi lần tải' %></label><input id="menu-page-size-input" name="pageSize" type="number" min="1" max="100" step="1" required value="<%= pageSize %>"><button type="submit">Áp dụng</button></form>
    </div>
    <% if (dishes.length) { %>
      <div class="menu-results" data-menu-results data-menu-view="<%= view %>" data-page="<%= page %>" data-page-count="<%= pageCount %>" data-page-size="<%= pageSize %>"><%- include('menu-items', { dishes, startIndex: (page - 1) * pageSize, page, pageCount, total }) %></div>
      <% if (view === 'pages') { %>
        <nav class="menu-page-numbers" aria-label="Phân trang thực đơn"><a href="<%= menuUrl({ page: Math.max(1, page - 1) }) %>" <%- page <= 1 ? 'aria-disabled="true" tabindex="-1"' : '' %>>← Trước</a><form class="menu-page-jump" action="/menu" method="get"><input type="hidden" name="q" value="<%= q %>"><input type="hidden" name="mode" value="<%= mode %>"><input type="hidden" name="category" value="<%= categoryId %>"><input type="hidden" name="minPrice" value="<%= minPrice %>"><input type="hidden" name="maxPrice" value="<%= maxPrice %>"><input type="hidden" name="available" value="<%= available %>"><input type="hidden" name="pageSize" value="<%= pageSize %>"><input type="hidden" name="view" value="<%= view %>"><label class="visually-hidden" for="menu-page-jump-input">Nhập trang cần mở</label><input id="menu-page-jump-input" name="page" type="number" inputmode="numeric" min="1" max="<%= pageCount %>" value="<%= page %>"><span aria-hidden="true">/</span><span class="menu-page-jump__total"><%= pageCount %></span><button class="visually-hidden" type="submit">Mở trang</button></form><a href="<%= menuUrl({ page: Math.min(pageCount, page + 1) }) %>" <%- page >= pageCount ? 'aria-disabled="true" tabindex="-1"' : '' %>>Sau →</a></nav>
      <% } else if (page < pageCount) { %>
        <p class="menu-load-more"><a class="button button-outline" href="<%= menuUrl({ page: page + 1 }) %>" data-menu-more><%= view === 'infinite' ? 'Cuộn xuống để xem thêm món' : 'Tải thêm món ↓' %></a></p>
      <% } else { %><p class="menu-load-more" data-menu-complete>Đã hiển thị toàn bộ <%= total %> món.</p><% } %>
      <p class="menu-load-error" data-menu-error role="alert" hidden></p>
    <% } else { %><div class="empty-state"><h2>Chưa tìm thấy món phù hợp</h2><p>Thử một từ khóa khác hoặc xem tất cả món trong thực đơn.</p><a class="text-link" href="/menu">Xem tất cả món <span aria-hidden="true">↗</span></a></div><% } %>
  <% } %>
</div><span class="section-lantern section-lantern--right" aria-hidden="true"></span></section>
