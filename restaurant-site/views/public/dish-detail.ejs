<section class="dish-detail-page section-pad" data-lantern-section><div class="wrap">
  <a class="back-link" href="/menu">← Trở lại thực đơn</a>
  <article class="dish-detail-grid">
    <figure class="dish-detail-photo reveal reveal-paper" data-reveal-from="left"><img src="<%= dish.imageUrl || '/images/food-fallback.svg' %>" alt="<%= dish.name %>" fetchpriority="high" data-scroll-drift></figure>
    <div class="dish-detail-copy reveal reveal-copy" data-reveal-from="right"><p class="eyebrow"><%= dish.category.name %> / MÓN NHÀ</p><h1><%= dish.name %></h1><p class="dish-detail-price"><%= formatVnd(dish.price) %></p><p class="dish-detail-description"><%= dish.description %></p><% if (dish.isAvailable) { %><p class="availability available"><span></span> Đang có món</p><% } else { %><p class="availability unavailable"><span></span> Món tạm hết hôm nay</p><% } %><h2>Nguyên liệu</h2><%- include('../partials/ingredient-list', { dish }) %><p class="dish-note">Thành phần có thể thay đổi nhẹ theo mùa. Vui lòng trao đổi với nhân viên nếu bạn có dị ứng thực phẩm.</p><a class="button button-dark" href="/reservations/new">Gửi yêu cầu đặt bàn <span aria-hidden="true">↗</span></a></div>
  </article>
</div><span class="section-lantern section-lantern--left" aria-hidden="true"></span></section>
