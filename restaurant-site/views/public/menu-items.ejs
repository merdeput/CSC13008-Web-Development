<div data-menu-fragment data-menu-page="<%= page %>" data-menu-page-count="<%= pageCount %>" data-menu-total="<%= total %>"><div class="dish-card-grid menu-card-grid">
  <% dishes.forEach((dish, index) => { %><article class="dish-card reveal"><a class="dish-card-image" href="/dishes/<%= dish.id %>"><img src="<%= dish.imageUrl || '/images/food-fallback.svg' %>" alt="<%= dish.name %>" loading="lazy" data-scroll-drift><span class="dish-card-index"><%= String(startIndex + index + 1).padStart(2, '0') %></span><% if (!dish.isAvailable) { %><span class="availability-ribbon">Tạm hết hôm nay</span><% } %></a><div class="dish-card-meta"><span><%= dish.category.name %></span><span><%= formatVnd(dish.price) %></span></div><h2><a href="/dishes/<%= dish.id %>"><%= dish.name %></a></h2><p><%= dish.description %></p><%- include('../partials/ingredient-list', { dish }) %></article><% }) %>
</div></div>
