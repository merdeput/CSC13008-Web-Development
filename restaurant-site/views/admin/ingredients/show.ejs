<section class="admin-page-heading"><div><p class="eyebrow">BẾP / CHI TIẾT</p><h1><%= ingredient.name %></h1><p>Đang được dùng trong <%= ingredient.dishes.length %> món.</p></div><div class="admin-heading-actions"><a class="admin-secondary-button" href="/admin/ingredients/<%= ingredient.id %>/edit">Chỉnh sửa</a><a class="admin-danger-button" href="/admin/ingredients/<%= ingredient.id %>/delete">Xóa nguyên liệu</a></div></section>
<section class="admin-panel"><div class="admin-panel-heading"><div><p class="eyebrow">MÓN ĂN LIÊN QUAN</p><h2>Nơi đang sử dụng</h2></div><a class="admin-text-link" href="/admin/ingredients">Quay lại danh sách <span aria-hidden="true">↗</span></a></div>
  <% if (ingredient.dishes.length) { %><ul class="ingredient-usage-list"><% ingredient.dishes.forEach((link) => { %><li><a class="table-primary-link" href="/admin/dishes/<%= link.dish.id %>"><%= link.dish.name %></a></li><% }) %></ul><% } else { %><p class="admin-empty">Nguyên liệu này chưa được gắn với món ăn nào.</p><% } %>
</section>
