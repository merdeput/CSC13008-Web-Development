<section class="admin-page-heading"><div><p class="eyebrow">ĐẶT BÀN / CHI TIẾT</p><h1><%= reservation.referenceCode %></h1><p>Gửi ngày <%= formatDateTimeHcm(reservation.createdAt) %></p></div><div class="admin-heading-actions"><a class="admin-secondary-button" href="/admin/reservations/<%= reservation.id %>/edit">Cập nhật yêu cầu</a><a class="admin-danger-button" href="/admin/reservations/<%= reservation.id %>/delete">Xóa</a></div></section>
<section class="admin-panel reservation-detail-panel"><div class="reservation-detail-status"><span class="status-badge status-<%= reservation.status.toLowerCase() %>"><%= statusLabels[reservation.status] %></span><strong><%= formatDateTimeHcm(reservation.startsAt) %></strong><small>Giờ Việt Nam · Asia/Ho_Chi_Minh</small></div><dl class="detail-list"><div><dt>Khách hàng</dt><dd><%= reservation.customerName %></dd></div><div><dt>Điện thoại</dt><dd><a href="tel:<%= reservation.phone %>"><%= reservation.phone %></a></dd></div><div><dt>Email</dt><dd><%= reservation.email || 'Không cung cấp' %></dd></div><div><dt>Số khách</dt><dd><%= reservation.guestCount %></dd></div><div><dt>Lời nhắn của khách</dt><dd><%= reservation.customerNote || 'Không có lời nhắn.' %></dd></div><div><dt>Ghi chú nội bộ</dt><dd><%= reservation.adminNote || 'Chưa có.' %></dd></div></dl><p class="admin-direct-note">Yêu cầu không tự động giữ bàn. Hãy liên hệ khách để xác nhận.</p></section>
