<section class="admin-page-heading"><div><p class="eyebrow">ĐẶT BÀN / BIỂU MẪU</p><h1>Cập nhật <%= reservation.referenceCode %></h1><p>Chỉ chọn trạng thái tiếp theo trong quy trình.</p></div><a class="admin-secondary-button" href="/admin/reservations/<%= reservation.id %>">← Chi tiết yêu cầu</a></section>
<section class="admin-panel admin-form-panel"><%- include('../../partials/form-errors', { errors }) %><form class="admin-form" action="<%= formAction %>" method="post" novalidate><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="_method" value="PATCH"><div class="admin-form-grid">
  <div class="form-field"><label for="customerName">Họ tên <span aria-hidden="true">*</span></label><input id="customerName" name="customerName" maxlength="120" required value="<%= formData.customerName || '' %>" aria-invalid="<%= errors.customerName ? 'true' : 'false' %>"><%- include('../../partials/field-error', { errors, field: 'customerName' }) %></div>
  <div class="form-field"><label for="phone">Điện thoại <span aria-hidden="true">*</span></label><input id="phone" name="phone" type="tel" maxlength="40" required value="<%= formData.phone || '' %>" aria-invalid="<%= errors.phone ? 'true' : 'false' %>"><%- include('../../partials/field-error', { errors, field: 'phone' }) %></div>
  <div class="form-field"><label for="email">Email</label><input id="email" name="email" type="email" maxlength="254" value="<%= formData.email || '' %>" aria-invalid="<%= errors.email ? 'true' : 'false' %>"><%- include('../../partials/field-error', { errors, field: 'email' }) %></div>
  <div class="form-field"><label for="guestCount">Số khách <span aria-hidden="true">*</span></label><input id="guestCount" name="guestCount" type="number" min="1" max="<%= restaurantConfig.maxPartySize %>" step="1" required value="<%= formData.guestCount || '' %>" aria-invalid="<%= errors.guestCount ? 'true' : 'false' %>"><%- include('../../partials/field-error', { errors, field: 'guestCount' }) %></div>
  <div class="form-field"><label for="date">Ngày đến <span aria-hidden="true">*</span></label><input id="date" name="date" type="date" min="<%= todayInHcm() %>" required value="<%= formData.date || '' %>" aria-invalid="<%= errors.date ? 'true' : 'false' %>"><%- include('../../partials/field-error', { errors, field: 'date' }) %></div>
  <div class="form-field"><label for="time">Giờ đến <span aria-hidden="true">*</span></label><input id="time" name="time" type="time" min="<%= restaurantConfig.openingTime %>" max="<%= restaurantConfig.closingTime %>" required value="<%= formData.time || '' %>" aria-invalid="<%= errors.time ? 'true' : 'false' %>"><%- include('../../partials/field-error', { errors, field: 'time' }) %></div>
  <div class="form-field"><label for="status">Trạng thái <span aria-hidden="true">*</span></label><select id="status" name="status" required aria-invalid="<%= errors.status ? 'true' : 'false' %>"><% statusOptions.forEach((status) => { %><option value="<%= status %>" <%- formData.status === status ? 'selected' : '' %>><%= statusLabels[status] %></option><% }) %></select><%- include('../../partials/field-error', { errors, field: 'status' }) %></div>
  <div class="form-field form-field-wide"><label for="customerNote">Lời nhắn của khách</label><textarea id="customerNote" name="customerNote" maxlength="1200" rows="3"><%= formData.customerNote || '' %></textarea><%- include('../../partials/field-error', { errors, field: 'customerNote' }) %></div>
  <div class="form-field form-field-wide"><label for="adminNote">Ghi chú nội bộ</label><textarea id="adminNote" name="adminNote" maxlength="1200" rows="3" aria-invalid="<%= errors.adminNote ? 'true' : 'false' %>"><%= formData.adminNote || '' %></textarea><%- include('../../partials/field-error', { errors, field: 'adminNote' }) %></div>
 </div><p class="field-help">Múi giờ nhập và hiển thị: Asia/Ho_Chi_Minh. Giờ và quy mô nhóm tuân theo cấu hình của website.</p><div class="admin-form-actions"><button class="admin-primary-button" type="submit">Lưu yêu cầu</button><a class="admin-secondary-button" href="/admin/reservations/<%= reservation.id %>">Hủy</a></div></form></section>
