<section class="admin-page-heading"><div><p class="eyebrow">NỘI DUNG / THỰC ĐƠN</p><h1>Món ăn</h1><p><%= q ? `${total} kết quả phù hợp với “${q}”.` : `${total} món trong danh mục quản trị.` %></p></div><a class="admin-primary-button" href="/admin/dishes/new">+ Thêm món ăn</a></section>
<section class="admin-panel"><div class="admin-panel-heading"><div><p class="eyebrow">DANH SÁCH</p><h2>Tất cả món ăn</h2></div><span class="admin-count"><%= total %> mục</span></div>
  <%- include('../../partials/admin-search', { basePath, inputId: 'dishSearch', label: 'Tìm món ăn', placeholder: 'Tên món, mô tả, danh mục hoặc nguyên liệu', q }) %>
  <% if (items.length) { %>
    <div class="admin-table-wrap"><table class="admin-table"><thead><tr>
      <%- include('../../partials/admin-sort-header', { label: 'Món ăn', sortKey: 'name', sortBy, sortDirection, sortLinks }) %>
      <%- include('../../partials/admin-sort-header', { label: 'Danh mục', sortKey: 'category', sortBy, sortDirection, sortLinks }) %>
      <%- include('../../partials/admin-sort-header', { label: 'Giá', sortKey: 'price', sortBy, sortDirection, sortLinks }) %>
      <%- include('../../partials/admin-sort-header', { label: 'Hiển thị', sortKey: 'visibility', sortBy, sortDirection, sortLinks }) %>
      <%- include('../../partials/admin-sort-header', { label: 'Phục vụ', sortKey: 'availability', sortBy, sortDirection, sortLinks }) %>
      <%- include('../../partials/admin-sort-header', { label: 'Cập nhật', sortKey: 'updatedAt', sortBy, sortDirection, sortLinks }) %>
      <th scope="col">Thao tác</th>
    </tr></thead><tbody>
      <% items.forEach((dish) => { %>
        <tr>
          <td><a class="table-primary-link" href="/admin/dishes/<%= dish.id %>"><%= dish.name %></a><small class="table-subline">ID: <%= dish.id %></small></td>
          <td><%= dish.category.name %></td>
          <td><%= formatVnd(dish.price) %></td>
          <td><span class="status-badge <%= dish.isPublished ? 'status-confirmed' : 'status-cancelled' %>"><%= dish.isPublished ? 'Đã công khai' : 'Bản nháp' %></span></td>
          <td><%= dish.isAvailable ? 'Đang có' : 'Tạm hết' %><%= dish.isFeatured ? ' · Nổi bật' : '' %></td>
          <td><%= formatDateTimeHcm(dish.updatedAt) %></td>
          <td><a class="table-action" href="/admin/dishes/<%= dish.id %>">Mở</a></td>
        </tr>
      <% }) %>
    </tbody></table></div>
  <% } else { %><p class="admin-empty"><%= q ? `Không tìm thấy món ăn phù hợp với “${q}”.` : 'Chưa có món ăn. Hãy thêm món đầu tiên.' %></p><% } %>
  <%- include('../../partials/pagination', { page, pageCount, basePath, paginationQuery }) %>
</section>
