<section class="admin-page-heading"><div><p class="eyebrow">NỘI DUNG / THỰC ĐƠN</p><h1>Món ăn</h1><p><%= total %> món trong danh mục quản trị.</p></div><a class="admin-primary-button" href="/admin/dishes/new">+ Thêm món ăn</a></section>
<section class="admin-panel"><div class="admin-panel-heading"><div><p class="eyebrow">DANH SÁCH</p><h2>Tất cả món ăn</h2></div><span class="admin-count"><%= total %> mục</span></div>
  <% if (items.length) { %><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Món ăn</th><th>Danh mục</th><th>Giá</th><th>Hiển thị</th><th>Phục vụ</th><th>Cập nhật</th><th></th></tr></thead><tbody><% items.forEach((dish) => { %><tr><td><a class="table-primary-link" href="/admin/dishes/<%= dish.id %>"><%= dish.name %></a><small class="table-subline"><%= dish.slug %></small></td><td><%= dish.category.name %></td><td><%= formatVnd(dish.price) %></td><td><span class="status-badge <%= dish.isPublished ? 'status-confirmed' : 'status-cancelled' %>"><%= dish.isPublished ? 'Đã công khai' : 'Bản nháp' %></span></td><td><%= dish.isAvailable ? 'Đang có' : 'Tạm hết' %><%= dish.isFeatured ? ' · Nổi bật' : '' %></td><td><%= formatDateTimeHcm(dish.updatedAt) %></td><td><a class="table-action" href="/admin/dishes/<%= dish.id %>">Mở</a></td></tr><% }) %></tbody></table></div><% } else { %><p class="admin-empty">Chưa có món ăn. Hãy thêm món đầu tiên.</p><% } %>
  <%- include('../../partials/pagination', { page, pageCount, basePath, paginationQuery: '' }) %>
</section>
