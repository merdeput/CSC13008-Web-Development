<section class="admin-page-heading"><div><p class="eyebrow">THỰC ĐƠN / CHI TIẾT</p><h1><%= dish.name %></h1><p><%= dish.slug %></p></div><div class="admin-heading-actions"><a class="admin-secondary-button" href="/admin/dishes/<%= dish.id %>/edit">Chỉnh sửa</a><a class="admin-danger-button" href="/admin/dishes/<%= dish.id %>/delete">Xóa món</a></div></section>
<section class="admin-panel admin-detail-panel"><div class="admin-detail-photo"><img src="<%= dish.imageUrl || '/images/food-fallback.svg' %>" alt="<%= dish.name %>" data-fallback="/images/food-fallback.svg"></div><div class="admin-detail-content"><dl class="detail-list"><div><dt>Danh mục</dt><dd><%= dish.category.name %></dd></div><div><dt>Giá</dt><dd><%= formatVnd(dish.price) %></dd></div><div><dt>Công khai</dt><dd><%= dish.isPublished ? 'Có' : 'Không, bản nháp' %></dd></div><div><dt>Tình trạng</dt><dd><%= dish.isAvailable ? 'Đang phục vụ' : 'Tạm hết' %></dd></div><div><dt>Nổi bật</dt><dd><%= dish.isFeatured ? 'Có' : 'Không' %></dd></div><div><dt>Cập nhật</dt><dd><%= formatDateTimeHcm(dish.updatedAt) %></dd></div><div><dt>Mô tả</dt><dd><%= dish.description %></dd></div><div><dt>Nguyên liệu</dt><dd><%- include('../../partials/ingredient-list', { dish }) %></dd></div></dl></div></section>
