<section class="admin-page-heading"><div><p class="eyebrow">ĐỘI NGŨ / CHI TIẾT</p><h1><%= chef.name %></h1><p><%= chef.title %></p></div><div class="admin-heading-actions"><a class="admin-secondary-button" href="/admin/chefs/<%= chef.id %>/edit">Chỉnh sửa</a><a class="admin-danger-button" href="/admin/chefs/<%= chef.id %>/delete">Xóa hồ sơ</a></div></section>
<section class="admin-panel admin-detail-panel"><div class="admin-detail-photo"><img src="<%= chef.imageUrl || '/images/food-fallback.svg' %>" alt="Chân dung <%= chef.name %>" data-fallback="/images/food-fallback.svg"></div><div class="admin-detail-content"><dl class="detail-list"><div><dt>Chức danh</dt><dd><%= chef.title %></dd></div><div><dt>Sở trường</dt><dd><%= chef.specialty || '—' %></dd></div><div><dt>Thứ tự</dt><dd><%= chef.sortOrder %></dd></div><div><dt>Hiển thị</dt><dd><%= chef.isPublished ? 'Công khai' : 'Bản nháp' %></dd></div><div><dt>Tiểu sử</dt><dd><%= chef.bio || '—' %></dd></div></dl></div></section>
