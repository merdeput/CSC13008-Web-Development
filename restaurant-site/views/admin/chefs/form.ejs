<section class="admin-page-heading"><div><p class="eyebrow">ĐỘI NGŨ / BIỂU MẪU</p><h1><%= heading %></h1><p>Hồ sơ công khai sẽ xuất hiện ở trang Người giữ bếp.</p></div><a class="admin-secondary-button" href="/admin/chefs">← Danh sách đầu bếp</a></section>
<section class="admin-panel admin-form-panel"><%- include('../../partials/form-errors', { errors }) %><form class="admin-form" action="<%= formAction %>" method="post" novalidate><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if (methodOverride) { %><input type="hidden" name="_method" value="<%= methodOverride %>"><% } %><div class="admin-form-grid">
  <div class="form-field"><label for="name">Họ tên <span aria-hidden="true">*</span></label><input id="name" name="name" maxlength="120" required value="<%= formData.name || '' %>" aria-invalid="<%= errors.name ? 'true' : 'false' %>"><%- include('../../partials/field-error', { errors, field: 'name' }) %></div>
  <div class="form-field"><label for="title">Chức danh <span aria-hidden="true">*</span></label><input id="title" name="title" maxlength="140" required value="<%= formData.title || '' %>" aria-invalid="<%= errors.title ? 'true' : 'false' %>"><%- include('../../partials/field-error', { errors, field: 'title' }) %></div>
  <div class="form-field"><label for="specialty">Sở trường</label><input id="specialty" name="specialty" maxlength="180" value="<%= formData.specialty || '' %>" aria-invalid="<%= errors.specialty ? 'true' : 'false' %>"><%- include('../../partials/field-error', { errors, field: 'specialty' }) %></div>
  <div class="form-field"><label for="imageUrl">Đường dẫn ảnh</label><input id="imageUrl" name="imageUrl" type="url" maxlength="2048" value="<%= formData.imageUrl || '' %>" placeholder="https://…" aria-invalid="<%= errors.imageUrl ? 'true' : 'false' %>"><%- include('../../partials/field-error', { errors, field: 'imageUrl' }) %></div>
  <div class="form-field form-field-wide"><label for="bio">Tiểu sử</label><textarea id="bio" name="bio" rows="5" maxlength="2400" aria-invalid="<%= errors.bio ? 'true' : 'false' %>"><%= formData.bio || '' %></textarea><%- include('../../partials/field-error', { errors, field: 'bio' }) %></div>
  <div class="form-field"><label for="sortOrder">Thứ tự hiển thị</label><input id="sortOrder" name="sortOrder" type="number" min="0" step="1" value="<%= formData.sortOrder == null ? '0' : formData.sortOrder %>" aria-invalid="<%= errors.sortOrder ? 'true' : 'false' %>"><%- include('../../partials/field-error', { errors, field: 'sortOrder' }) %></div>
 </div><div class="form-field form-field-wide ingredient-picker dish-assignment-picker" data-dish-assignment-picker>
  <label for="dishAssignmentSearch">Món đầu bếp phụ trách</label>
  <div class="ingredient-picker__selected" role="group" aria-label="Món đang được phụ trách"><div class="ingredient-picker__selected-heading"><strong>Món đã chọn</strong><span data-assignment-count><%= selectedDishIds.length %> món</span></div><div class="ingredient-picker__chips" data-assignment-chips aria-live="polite"><span class="ingredient-picker__empty" data-assignment-empty <%- selectedDishIds.length ? 'hidden' : '' %>>Chưa gán món nào.</span></div></div>
  <input id="dishAssignmentSearch" type="search" autocomplete="off" placeholder="Tìm món theo tên..." aria-controls="dish-assignment-options" data-dish-assignment-search>
  <small class="field-help">Đánh dấu các món do đầu bếp phụ trách. Món đang gán cho đầu bếp khác sẽ được chuyển khi lưu.</small>
  <fieldset class="ingredient-picker__list" aria-invalid="<%= errors.dishIds ? 'true' : 'false' %>"><legend>Chọn món</legend>
   <div id="dish-assignment-options" class="ingredient-picker__options">
    <% dishes.forEach((dish) => { %><label class="ingredient-picker__option" data-dish-assignment-option data-name="<%= dish.name %>"><input type="checkbox" name="dishIds" value="<%= dish.id %>" <%- selectedDishIds.includes(dish.id) ? 'checked' : '' %>><span><%= dish.name %><small><%= dish.chefId && dish.chefId !== (formData.id || '') ? ' · Hiện thuộc ' + (dish.chef?.name || 'đầu bếp khác') : '' %></small></span></label><% }) %>
   </div><p class="ingredient-picker__no-results" data-dish-assignment-empty hidden>Không tìm thấy món phù hợp.</p>
  </fieldset><%- include('../../partials/field-error', { errors, field: 'dishIds' }) %>
 </div>
<fieldset class="checkbox-fieldset"><legend>Trạng thái</legend><label class="check-row"><input type="checkbox" name="isPublished" <%- formData.isPublished ? 'checked' : '' %>><span><strong>Công khai hồ sơ</strong><small>Đầu bếp chưa công khai chỉ thấy trong khu vực quản trị.</small></span></label></fieldset><div class="admin-form-actions"><button class="admin-primary-button" type="submit">Lưu hồ sơ</button><a class="admin-secondary-button" href="/admin/chefs">Hủy</a></div></form></section>
