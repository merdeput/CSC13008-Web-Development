generator client {
  provider = "prisma-client"
  output   = "../server/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PhotoStatus {
  pending
  ready
  pending_delete
}

enum CleanupStatus {
  queued
  running
  failed
}

enum StoredObjectKind {
  original
  variant
}

model User {
  id                 String        @id @default(uuid()) @db.Uuid
  username           String        @unique
  usernameNormalized String        @unique @map("username_normalized")
  passwordHash       String?       @map("password_hash")
  displayName        String?       @map("display_name")
  bio                String?
  avatarUrl          String?       @map("avatar_url")
  isSystem           Boolean       @default(false) @map("is_system")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  photos             Photo[]
  sessions           UserSession[]

  @@map("users")
}

model UserSession {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  tokenHash        String   @unique @map("token_hash")
  csrfToken        String   @map("csrf_token")
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt       DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Photo {
  id                       String               @id @default(uuid()) @db.Uuid
  ownerId                  String?              @map("owner_id") @db.Uuid
  owner                    User?                @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  title                    String
  caption                  String?
  altText                  String?              @map("alt_text")
  category                 String?
  photographerCredit       String?              @map("photographer_credit")
  locationName             String?              @map("location_name")
  locationContinent        String?              @map("location_continent")
  locationRegion           String?              @map("location_region")
  locationCountry          String?              @map("location_country")
  competition              String?
  award                    String?
  photoYear                Int?                 @map("photo_year")
  speciesCommon            String?              @map("species_common")
  speciesLatin             String?              @map("species_latin")
  story                    String?
  permissionConfirmedAt    DateTime?            @map("permission_confirmed_at") @db.Timestamptz(6)
  status                   PhotoStatus          @default(pending)
  currentVersion           Int                  @default(1) @map("current_version")
  currentEdit              Json?                @map("current_edit")
  originalBucket           String               @map("original_bucket")
  originalKey              String               @unique @map("original_key")
  originalMimeType         String               @map("original_mime_type")
  originalBytes            BigInt               @map("original_bytes")
  originalChecksum         String               @map("original_checksum")
  createdAt                DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  variants                 PhotoVariant[]
  storedObjects            StoredObject[]
  cleanupJob               CleanupJob?
  tags                     PhotoTag[]

  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([ownerId, createdAt(sort: Desc)])
  @@index([category, createdAt(sort: Desc)])
  @@map("photos")
}

model PhotoVariant {
  id           String   @id @default(uuid()) @db.Uuid
  photoId      String   @map("photo_id") @db.Uuid
  version      Int      @default(1)
  widthTarget  Int      @map("width_target")
  width        Int
  height       Int
  bucket       String
  key          String   @unique
  mimeType     String   @map("mime_type")
  bytes        BigInt
  checksum     String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  photo        Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([photoId, version, widthTarget])
  @@index([photoId, width])
  @@map("photo_variants")
}

model StoredObject {
  id        String          @id @default(uuid()) @db.Uuid
  photoId   String          @map("photo_id") @db.Uuid
  bucket    String
  key       String
  kind      StoredObjectKind
  uploadedAt DateTime?      @map("uploaded_at") @db.Timestamptz(6)
  photo     Photo           @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([bucket, key])
  @@index([photoId, uploadedAt])
  @@map("photo_stored_objects")
}

model CleanupJob {
  id            String         @id @default(uuid()) @db.Uuid
  photoId       String         @unique @map("photo_id") @db.Uuid
  status        CleanupStatus  @default(queued)
  attempts      Int            @default(0)
  nextAttemptAt DateTime       @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  leaseUntil    DateTime?      @map("lease_until") @db.Timestamptz(6)
  lastError     String?        @map("last_error")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  photo         Photo          @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("storage_cleanup_jobs")
}

model Tag {
  id       String     @id @default(uuid()) @db.Uuid
  name     String     @unique
  slug     String     @unique
  photos   PhotoTag[]

  @@map("tags")
}

model PhotoTag {
  photoId String @map("photo_id") @db.Uuid
  tagId   String @map("tag_id") @db.Uuid
  photo   Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([photoId, tagId])
  @@index([tagId, photoId])
  @@map("photo_tags")
}
