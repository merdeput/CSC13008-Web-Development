NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Runtime URL: use the Supabase Session pooler connection string (port 5432)
# or a direct Postgres connection URL. Keep this server-side.
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Prisma CLI migrations should use the direct Supabase database connection.
DIRECT_URL=postgresql://postgres:<database-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# Optional: Supabase's downloaded database CA certificate enables server identity verification.
# Without this file, database traffic is encrypted but the pooler's certificate is not verified.
DATABASE_SSL_CA_FILE=

# Documented restaurant defaults, configurable for the deployment.
RESTAURANT_TIME_ZONE=Asia/Ho_Chi_Minh
RESTAURANT_OPENING_TIME=11:00
RESTAURANT_CLOSING_TIME=22:00
RESTAURANT_MAX_PARTY_SIZE=12
