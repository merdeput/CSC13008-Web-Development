<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Edit <%= student.name %> · Student List</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/styles.css" rel="stylesheet">
  </head>
  <body class="app-shell workspace-shell">
    <%- include('partials/header') %>
    <main class="container-fluid record-page px-3 px-xl-5 py-4">
      <div class="page-heading mb-4">
        <p class="eyebrow mb-2">COMPUTER SCIENCE DEPARTMENT / UPDATE RECORD</p>
        <h1 class="fw-bold">Edit Student</h1>
        <p class="text-secondary mb-0">Update the information saved in the student directory.</p>
      </div>
      <a href="/students/<%= encodeURIComponent(student.id) %>" class="text-decoration-none">← Back to student</a>
      <div class="directory-toolbar mb-3">
        <div><p class="eyebrow mb-1">STUDENT RECORD</p><h2 class="h4 mb-0 font-monospace"><%= student.id %></h2></div>
      </div>
      <div class="card app-card shadow-sm border-0 record-card">
        <div class="card-body p-3 p-lg-4">
          <p class="eyebrow">EDIT DETAILS</p>
          <% if (errors.form) { %><div class="alert alert-danger"><%= errors.form %></div><% } %>
          <form action="/students/<%= encodeURIComponent(student.id) %>" method="post" novalidate>
            <div class="row g-3">
              <div class="col-md-6"><label for="name" class="form-label">Full name</label><input id="name" name="name" value="<%= formData.name || '' %>" class="form-control <%= errors.name ? 'is-invalid' : '' %>" required><% if (errors.name) { %><div class="invalid-feedback"><%= errors.name %></div><% } %></div>
              <div class="col-md-6"><label for="email" class="form-label">Email</label><input id="email" name="email" type="email" value="<%= formData.email || '' %>" class="form-control <%= errors.email ? 'is-invalid' : '' %>" required><% if (errors.email) { %><div class="invalid-feedback"><%= errors.email %></div><% } %></div>
              <div class="col-md-6"><label for="dob" class="form-label">Date of birth</label><input id="dob" name="dob" type="date" value="<%= formData.dob || '' %>" class="form-control <%= errors.dob ? 'is-invalid' : '' %>" required><% if (errors.dob) { %><div class="invalid-feedback"><%= errors.dob %></div><% } %></div>
              <div class="col-md-6"><label for="major" class="form-label">Major</label><input id="major" name="major" value="<%= formData.major || '' %>" class="form-control <%= errors.major ? 'is-invalid' : '' %>" required><% if (errors.major) { %><div class="invalid-feedback"><%= errors.major %></div><% } %></div>
            </div>
            <div class="d-flex gap-2 mt-4"><button class="btn btn-primary" type="submit">Save Changes</button><a class="btn btn-outline-secondary" href="/students/<%= encodeURIComponent(student.id) %>">Cancel</a></div>
          </form>
        </div>
      </div>
    </main>
  </body>
</html>
