<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Student List</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/styles.css" rel="stylesheet">
  </head>
  <body class="app-shell workspace-shell">
    <%- include('partials/header') %>
    <main class="container-fluid directory-page px-3 px-xl-5 py-4">
      <div class="page-heading mb-4">
        <p class="eyebrow mb-2">COMPUTER SCIENCE DEPARTMENT / DIRECTORY</p>
        <h1 class="fw-bold">Student Registry</h1>
        <p class="text-secondary mb-0">Create, review, update, and manage student records.</p>
      </div>

      <% if (success) { %><div class="alert alert-success" role="alert">Student created successfully.</div><% } %>
      <div class="directory-toolbar mb-3">
        <div><p class="eyebrow mb-1">DATABASE / STUDENTS</p><h2 class="h4 mb-0">All Students</h2></div>
        <div class="directory-actions">
          <form class="directory-filters" action="/students" method="get">
            <label class="visually-hidden" for="sortBy">Sort by</label>
            <select class="form-select form-select-sm" id="sortBy" name="sortBy" onchange="this.form.requestSubmit()">
              <option value="id" <%= sortBy === 'id' ? 'selected' : '' %>>ID</option>
              <option value="name" <%= sortBy === 'name' ? 'selected' : '' %>>Name</option>
              <option value="email" <%= sortBy === 'email' ? 'selected' : '' %>>Email</option>
              <option value="dob" <%= sortBy === 'dob' ? 'selected' : '' %>>Date of birth</option>
              <option value="major" <%= sortBy === 'major' ? 'selected' : '' %>>Major</option>
            </select>
            <label class="visually-hidden" for="sortDirection">Sort direction</label>
            <select class="form-select form-select-sm" id="sortDirection" name="sortDirection" onchange="this.form.requestSubmit()">
              <option value="asc" <%= sortDirection === 'asc' ? 'selected' : '' %>>Ascending</option>
              <option value="desc" <%= sortDirection === 'desc' ? 'selected' : '' %>>Descending</option>
            </select>
            <label class="visually-hidden" for="majorFilter">Filter by major</label>
            <select class="form-select form-select-sm" id="majorFilter" name="major" onchange="this.form.requestSubmit()">
              <option value="">All majors</option>
              <% majors.forEach((major) => { %><option value="<%= major %>" <%= selectedMajor === major ? 'selected' : '' %>><%= major %></option><% }) %>
            </select>
            <button class="btn btn-sm btn-outline-primary" type="submit">Apply</button>
            <% if (selectedMajor) { %><a class="btn btn-sm btn-outline-secondary" href="/students?sortBy=<%= encodeURIComponent(sortBy) %>&amp;sortDirection=<%= encodeURIComponent(sortDirection) %>">Clear</a><% } %>
          </form>
          <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#createStudentModal">+ Create Student</button>
        </div>
      </div>
      <div class="row">
        <section class="col-12">
          <div class="card app-card shadow-sm border-0">
            <div class="card-body p-3 p-lg-4">
              <span class="visually-hidden">Student records</span>
              <div class="d-flex justify-content-end mb-2"><span class="badge text-bg-primary rounded-pill"><%= students.length %> of <%= totalCount %> students</span></div>
              <% if (students.length) { %>
                <div class="table-responsive">
                  <table class="table table-hover align-middle mb-0">
                    <thead><tr>
                      <th><a class="sort-link" href="/students?sortBy=id&amp;sortDirection=<%= encodeURIComponent(sortDirection) %>&amp;major=<%= encodeURIComponent(selectedMajor) %>">ID<%= sortBy === 'id' ? (sortDirection === 'asc' ? ' ↑' : ' ↓') : '' %></a></th>
                      <th><a class="sort-link" href="/students?sortBy=name&amp;sortDirection=<%= encodeURIComponent(sortDirection) %>&amp;major=<%= encodeURIComponent(selectedMajor) %>">Name<%= sortBy === 'name' ? (sortDirection === 'asc' ? ' ↑' : ' ↓') : '' %></a></th>
                      <th><a class="sort-link" href="/students?sortBy=email&amp;sortDirection=<%= encodeURIComponent(sortDirection) %>&amp;major=<%= encodeURIComponent(selectedMajor) %>">Email<%= sortBy === 'email' ? (sortDirection === 'asc' ? ' ↑' : ' ↓') : '' %></a></th>
                      <th><a class="sort-link" href="/students?sortBy=dob&amp;sortDirection=<%= encodeURIComponent(sortDirection) %>&amp;major=<%= encodeURIComponent(selectedMajor) %>">Date of birth<%= sortBy === 'dob' ? (sortDirection === 'asc' ? ' ↑' : ' ↓') : '' %></a></th>
                      <th><a class="sort-link" href="/students?sortBy=major&amp;sortDirection=<%= encodeURIComponent(sortDirection) %>&amp;major=<%= encodeURIComponent(selectedMajor) %>">Major<%= sortBy === 'major' ? (sortDirection === 'asc' ? ' ↑' : ' ↓') : '' %></a></th>
                      <th>Actions</th>
                    </tr></thead>
                    <tbody>
                      <% students.forEach((student) => { %>
                        <tr><td class="font-monospace fw-semibold"><a href="/students/<%= encodeURIComponent(student.id) %>"><%= student.id %></a></td><td><%= student.name %></td><td><a href="mailto:<%= student.email %>"><%= student.email %></a></td><td><%= student.dob %></td><td><%= student.major %></td><td><div class="d-flex gap-1"><a class="btn btn-sm btn-outline-primary" href="/students/<%= encodeURIComponent(student.id) %>">View</a><a class="btn btn-sm btn-outline-secondary" href="/students/<%= encodeURIComponent(student.id) %>/edit">Edit</a><form action="/students/<%= encodeURIComponent(student.id) %>/delete" method="post" onsubmit="return confirm('Delete this student?')"><button class="btn btn-sm btn-outline-danger" type="submit">Delete</button></form></div></td></tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } else { %>
                <p class="text-secondary mb-0">No students yet. Create the first one using the form.</p>
              <% } %>
            </div>
          </div>
        </section>
      </div>
      <div class="modal fade" id="createStudentModal" tabindex="-1" aria-labelledby="createStudentModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
          <div class="modal-content app-modal">
            <div class="modal-header">
              <div><p class="eyebrow mb-1">NEW RECORD</p><h2 class="modal-title h4" id="createStudentModalLabel">Create Student</h2></div>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <% if (errors.form) { %><div class="alert alert-danger" role="alert"><%= errors.form %></div><% } %>
              <form action="/students" method="post" novalidate data-student-validation data-existing-ids="<%= JSON.stringify(existingIds) %>" data-existing-emails="<%= JSON.stringify(existingEmails) %>">
                <input type="hidden" name="sortBy" value="<%= sortBy %>">
                <input type="hidden" name="sortDirection" value="<%= sortDirection %>">
                <input type="hidden" name="listMajor" value="<%= selectedMajor %>">
                <div class="mb-3"><label for="id" class="form-label">Student ID</label><input id="id" name="id" value="<%= formData.id || '' %>" class="form-control <%= errors.id ? 'is-invalid' : '' %>" required><% if (errors.id) { %><div class="invalid-feedback"><%= errors.id %></div><% } %></div>
                <div class="mb-3"><label for="name" class="form-label">Full name</label><input id="name" name="name" value="<%= formData.name || '' %>" class="form-control <%= errors.name ? 'is-invalid' : '' %>" required><% if (errors.name) { %><div class="invalid-feedback"><%= errors.name %></div><% } %></div>
                <div class="mb-3"><label for="email" class="form-label">Email</label><input id="email" name="email" type="email" value="<%= formData.email || '' %>" class="form-control <%= errors.email ? 'is-invalid' : '' %>" required><% if (errors.email) { %><div class="invalid-feedback"><%= errors.email %></div><% } %></div>
                <div class="mb-3"><label for="dob" class="form-label">Date of birth</label><input id="dob" name="dob" type="date" value="<%= formData.dob || '' %>" class="form-control <%= errors.dob ? 'is-invalid' : '' %>" required><% if (errors.dob) { %><div class="invalid-feedback"><%= errors.dob %></div><% } %></div>
                <div class="mb-4"><label for="major" class="form-label">Major</label><input id="major" name="major" value="<%= formData.major || '' %>" class="form-control <%= errors.major ? 'is-invalid' : '' %>" required><% if (errors.major) { %><div class="invalid-feedback"><%= errors.major %></div><% } %></div>
                <button class="btn btn-primary w-100" type="submit">Create Student</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/student-validation.js"></script>
    <% if (createModalOpen) { %><script>new bootstrap.Modal(document.getElementById('createStudentModal')).show();</script><% } %>
  </body>
</html>
