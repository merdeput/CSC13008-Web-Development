<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Student List</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/styles.css" rel="stylesheet">
  </head>
  <body class="app-shell workspace-shell">
    <%- include('partials/header') %>
    <main class="container-fluid directory-page px-3 px-xl-5 py-4">
      <div class="page-heading mb-4">
        <p class="eyebrow mb-2">COMPUTER SCIENCE DEPARTMENT / DIRECTORY</p>
        <h1 class="fw-bold">Student Registry</h1>
        <p class="text-secondary mb-0">Create, review, update, and manage student records.</p>
      </div>

      <% if (success) { %><div class="alert alert-success" role="alert">Student created successfully.</div><% } %>
      <div class="directory-toolbar mb-3">
        <div><p class="eyebrow mb-1">DATABASE / STUDENTS</p><h2 class="h4 mb-0">All Students</h2></div>
        <div class="directory-actions">
          <button class="btn btn-primary create-student-button" type="button" data-bs-toggle="modal" data-bs-target="#createStudentModal"><span class="create-student-icon" aria-hidden="true">+</span> Create Student</button>
        </div>
      </div>
      <div class="row">
        <section class="col-12">
          <div class="card app-card shadow-sm border-0">
            <div class="card-body p-3 p-lg-4">
              <span class="visually-hidden">Student records</span>
              <div class="d-flex justify-content-end mb-2"><span class="badge text-bg-primary rounded-pill"><%= students.length %> of <%= totalCount %> students</span></div>
              <% if (totalCount || selectedMajor) { %>
                <div class="table-responsive">
                  <table class="table table-hover align-middle mb-0">
                    <thead><tr>
                      <% [['id', 'ID'], ['name', 'Name'], ['email', 'Email'], ['dob', 'Date of birth'], ['major', 'Major']].forEach(([field, label]) => {
                        const active = sortBy === field;
                        const nextDirection = active && sortDirection === 'asc' ? 'desc' : 'asc';
                      %>
                        <th scope="col" aria-sort="<%= active ? (sortDirection === 'asc' ? 'ascending' : 'descending') : 'none' %>">
                          <a class="sort-link <%= active ? 'sort-active' : '' %>" href="/students?sortBy=<%= field %>&amp;sortDirection=<%= nextDirection %>&amp;major=<%= encodeURIComponent(selectedMajor) %>" aria-label="Sort by <%= label %> <%= nextDirection === 'asc' ? 'ascending' : 'descending' %>"><%= label %> <span aria-hidden="true"><%- active ? (sortDirection === 'asc' ? '&#8593;' : '&#8595;') : '&#8597;' %></span></a>
                          <% if (field === 'major') { %>
                            <button class="major-filter-toggle <%= selectedMajor ? 'is-active' : '' %>" type="button" popovertarget="majorFilterPopover" aria-label="Filter by major<%= selectedMajor ? ': ' + selectedMajor : '' %>" title="<%= selectedMajor ? 'Filtered by ' + selectedMajor : 'Filter by major' %>">
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16l-6 7v7l-4 2v-9z"/></svg>
                            </button>
                          <% } %>
                        </th>
                      <% }) %>
                      <th scope="col">Actions</th>
                    </tr></thead>
                    <tbody>
                      <% if (!students.length) { %><tr><td colspan="6" class="text-secondary py-4">No students match this filter. Select All majors to reset.</td></tr><% } %>
                      <% students.forEach((student) => { %>
                        <tr id="student-<%= student.id %>" <%- createdId === student.id ? 'data-created-student tabindex="-1"' : '' %>><td class="font-monospace fw-semibold"><a href="/students/<%= encodeURIComponent(student.id) %>"><%= student.id %></a></td><td><%= student.name %></td><td><a href="mailto:<%= student.email %>"><%= student.email %></a></td><td><%= student.dob %></td><td><%= student.major %></td><td><div class="d-flex gap-1"><a class="btn btn-sm btn-outline-primary" href="/students/<%= encodeURIComponent(student.id) %>">View</a><a class="btn btn-sm btn-outline-secondary" href="/students/<%= encodeURIComponent(student.id) %>/edit">Edit</a><form action="/students/<%= encodeURIComponent(student.id) %>/delete" method="post" onsubmit="return confirm('Delete this student?')"><button class="btn btn-sm btn-outline-danger" type="submit">Delete</button></form></div></td></tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } else { %>
                <p class="text-secondary mb-0">No students yet. Create the first one using the form.</p>
              <% } %>
            </div>
          </div>
        </section>
      </div>
      <div class="major-filter-popover" id="majorFilterPopover" popover aria-labelledby="majorFilterTitle">
        <div class="major-filter-heading">
          <h2 id="majorFilterTitle">Filter by major</h2>
          <button type="button" popovertarget="majorFilterPopover" popovertargetaction="hide" aria-label="Close major filter">&times;</button>
        </div>
        <div class="major-filter-options">
          <% ['', ...majors].forEach((major) => { %>
            <a class="major-filter-option <%= selectedMajor === major ? 'is-selected' : '' %>" href="/students?sortBy=<%= encodeURIComponent(sortBy) %>&amp;sortDirection=<%= encodeURIComponent(sortDirection) %>&amp;major=<%= encodeURIComponent(major) %>" <%- selectedMajor === major ? 'aria-current="true"' : '' %>><%= major || 'All majors' %><% if (selectedMajor === major) { %><span aria-hidden="true">&#10003;</span><% } %></a>
          <% }) %>
        </div>
      </div>
      <div class="modal fade" id="createStudentModal" tabindex="-1" aria-labelledby="createStudentModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
          <div class="modal-content app-modal">
            <div class="modal-header">
              <div><p class="eyebrow mb-1">NEW RECORD</p><h2 class="modal-title h4" id="createStudentModalLabel">Create Student</h2></div>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <% if (errors.form) { %><div class="alert alert-danger" role="alert"><%= errors.form %></div><% } %>
              <form action="/students" method="post" novalidate data-student-validation data-existing-ids="<%= JSON.stringify(existingIds) %>" data-existing-emails="<%= JSON.stringify(existingEmails) %>">
                <input type="hidden" name="sortBy" value="<%= sortBy %>">
                <input type="hidden" name="sortDirection" value="<%= sortDirection %>">
                <input type="hidden" name="listMajor" value="<%= selectedMajor %>">
                <div class="mb-3"><label for="id" class="form-label">Student ID</label><input id="id" name="id" value="<%= formData.id || '' %>" class="form-control <%= errors.id ? 'is-invalid' : '' %>" required><% if (errors.id) { %><div class="invalid-feedback"><%= errors.id %></div><% } %></div>
                <div class="mb-3"><label for="name" class="form-label">Full name</label><input id="name" name="name" value="<%= formData.name || '' %>" class="form-control <%= errors.name ? 'is-invalid' : '' %>" required><% if (errors.name) { %><div class="invalid-feedback"><%= errors.name %></div><% } %></div>
                <div class="mb-3"><label for="email" class="form-label">Email</label><input id="email" name="email" type="email" value="<%= formData.email || '' %>" class="form-control <%= errors.email ? 'is-invalid' : '' %>" required><% if (errors.email) { %><div class="invalid-feedback"><%= errors.email %></div><% } %></div>
                <div class="mb-3"><label for="dob" class="form-label">Date of birth</label><input id="dob" name="dob" type="date" value="<%= formData.dob || '' %>" class="form-control <%= errors.dob ? 'is-invalid' : '' %>" required><% if (errors.dob) { %><div class="invalid-feedback"><%= errors.dob %></div><% } %></div>
                <div class="mb-4"><label for="major" class="form-label">Major</label><input id="major" name="major" value="<%= formData.major || '' %>" class="form-control <%= errors.major ? 'is-invalid' : '' %>" required><% if (errors.major) { %><div class="invalid-feedback"><%= errors.major %></div><% } %></div>
                <button class="btn btn-primary create-student-button w-100" type="submit">Create Student</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/student-validation.js"></script>
    <script src="/student-list.js"></script>
    <% if (createModalOpen) { %><script>new bootstrap.Modal(document.getElementById('createStudentModal')).show();</script><% } %>
  </body>
</html>
