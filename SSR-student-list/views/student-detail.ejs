<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= student.name %> · Student</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/styles.css" rel="stylesheet">
  </head>
  <body class="app-shell workspace-shell">
    <%- include('partials/header') %>
    <main class="container-fluid record-page px-3 px-xl-5 py-4">
      <div class="page-heading mb-4">
        <p class="eyebrow mb-2">COMPUTER SCIENCE DEPARTMENT / STUDENT PROFILE</p>
        <h1 class="fw-bold"><%= student.name %></h1>
        <p class="text-secondary mb-0">Review and manage this student record.</p>
      </div>
      <a href="/students" class="text-decoration-none">← All students</a>
      <div class="directory-toolbar mt-3 mb-3">
        <div><p class="eyebrow mb-1">STUDENT RECORD</p><h2 class="h4 mb-0 font-monospace"><%= student.id %></h2></div>
        <div class="d-flex gap-2">
          <a class="btn btn-primary" href="/students/<%= encodeURIComponent(student.id) %>/edit">Edit Student</a>
          <form action="/students/<%= encodeURIComponent(student.id) %>/delete" method="post" onsubmit="return confirm('Delete this student?')"><button class="btn btn-outline-danger" type="submit">Delete</button></form>
        </div>
      </div>
      <div class="card app-card shadow-sm border-0 record-card">
        <div class="card-body p-3 p-lg-4">
          <p class="eyebrow">PROFILE DETAILS</p>
          <dl class="student-facts mb-0">
            <div><dt>Student ID</dt><dd class="font-monospace"><%= student.id %></dd></div>
            <div><dt>Email</dt><dd><a href="mailto:<%= student.email %>"><%= student.email %></a></dd></div>
            <div><dt>Date of birth</dt><dd><%= student.dob %></dd></div>
            <div><dt>Major</dt><dd><%= student.major %></dd></div>
          </dl>
        </div>
      </div>
    </main>
  </body>
</html>
